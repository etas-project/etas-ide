{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Etas",
  "scopeName": "source.etas",
  "fileTypes": ["es"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#types" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.documentation.etas", "match": "///.*$" },
        { "name": "comment.line.double-slash.etas", "match": "//.*$" },
        { "name": "comment.block.etas", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.etas",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "include": "#escapes" }]
        },
        {
          "name": "string.quoted.single.etas",
          "begin": "'",
          "end": "'",
          "patterns": [{ "include": "#escapes" }]
        }
      ]
    },
    "escapes": {
      "name": "constant.character.escape.etas",
      "match": "\\\\(?:[nrt0\"'\\\\]|x[\\da-fA-F]{2}|u\\{[\\da-fA-F]{1,6}\\})"
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(flow|tool|agent|action)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.etas" },
            "2": { "name": "entity.name.function.etas" }
          }
        },
        {
          "match": "\\b(type|alias|enum|spec|effect|protocol)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.etas" },
            "2": { "name": "entity.name.type.etas" }
          }
        },
        {
          "match": "(?<=:)\\s*\\b(callable|trace)\\b",
          "captures": { "1": { "name": "storage.type.spec-kind.etas" } }
        },
        { "name": "entity.name.function.decorator.etas", "match": "@[\\p{L}_][\\p{L}\\p{N}_.]*" }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.import.etas", "match": "\\b(module|import|as)\\b" },
        { "name": "keyword.declaration.etas", "match": "\\b(alias|type|enum|spec|impl|flow|effect|policy|action|tool|agent|protocol|extends)\\b" },
        { "name": "keyword.control.etas", "match": "\\b(if|else|match|for|in|while|limit|retry|return|break|continue)\\b" },
        { "name": "keyword.control.handler.etas", "match": "\\b(perform|handle|handler|with|resume|finish)\\b" },
        { "name": "keyword.other.etas", "match": "\\b(let|var|where|follows|allow|require|deny|before|after)\\b" },
        { "name": "storage.modifier.etas", "match": "\\b(private|public)\\b" },
        { "name": "variable.language.etas", "match": "\\bself\\b" }
      ]
    },
    "constants": {
      "patterns": [
        { "name": "constant.language.bool.etas", "match": "\\b(true|false)\\b" },
        { "name": "constant.language.variant.etas", "match": "\\b(Some|None|Ok|Err)\\b" },
        { "name": "constant.numeric.etas", "match": "\\b(?:0[xX][\\da-fA-F_]+|0[oO][0-7_]+|0[bB][01_]+|\\d[\\d_]*(?:\\.\\d[\\d_]*)?(?:[eE][+-]?[\\d_]+)?)\\b" }
      ]
    },
    "types": {
      "patterns": [
        { "name": "storage.type.primitive.etas", "match": "\\b(bool|string|bytes|char|unit|never|[iu](?:8|16|32|64|128|size)|f32|f64)\\b" },
        { "name": "support.type.etas", "match": "\\b[A-Z][A-Za-z0-9_]*\\b" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.etas", "match": "=>|->|~>|>>|<<|==|!=|<=|>=|&&|\\|\\||::|[=+*/%!?~|&^<>@#-]" },
        { "name": "punctuation.etas", "match": "[{}()\\[\\],;:.]" }
      ]
    }
  }
}
