{
  "name": "etas",
  "displayName": "Etas",
  "icon": "images/etas_icon-small-mod.png",
  "description": "Etas language support for Visual Studio Code",
  "version": "0.1.0",
  "publisher": "etas-project",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/etas-project/etas-ide.git",
    "directory": "editors/vscode"
  },
  "bugs": {
    "url": "https://github.com/etas-project/etas-ide/issues"
  },
  "homepage": "https://github.com/etas-project/etas-ide/tree/main/editors/vscode",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:etas",
    "onCommand:etas.restartServer"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "etas",
        "aliases": [
          "Etas",
          "etas"
        ],
        "extensions": [
          ".es"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/etas_icon-small-mod.png",
          "dark": "./images/etas_icon-small-mod.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "etas",
        "scopeName": "source.etas",
        "path": "./syntaxes/etas.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "etas.restartServer",
        "title": "Restart Etas Language Server"
      }
    ],
    "configuration": {
      "title": "Etas",
      "properties": {
        "etas.lsp.path": {
          "type": "string",
          "default": "etas-lsp",
          "description": "Path to the etas-lsp binary"
        },
        "etas.lsp.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "LSP server trace verbosity"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "esbuild ./src/extension.ts --bundle --external:vscode --format=cjs --platform=node --outfile=./dist/extension.js",
    "build-server": "cargo build -p etas_lsp --release --manifest-path ../../Cargo.toml && mkdir -p ./server && cp ../../target/release/etas-lsp ./server/etas-lsp && strip ./server/etas-lsp",
    "package:vsix": "npm run build-server && vsce package",
    "compile": "tsc -p ./ --noEmit",
    "watch": "tsc -watch -p ./ --noEmit"
  },
  "devDependencies": {
    "@vscode/vsce": "3.9.2",
    "@types/node": "^25.9.3",
    "@types/vscode": "^1.100.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "vscode-languageclient": "^8.1.0"
  }
}
